/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tricore-foods-and-errands",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tricore-foods-and-errands"
    }
  ],
  // Persistent CMS + shared login rate-limit (requires wrangler login):
  // 1. npm run cf:kv
  // 2. Paste id below
  // "kv_namespaces": [
  //   { "binding": "TRICORE_KV", "id": "<PASTE_KV_ID_HERE>" }
  // ],
  // Persistent media uploads (R2):
  // 1. npm run cf:r2
  // 2. Uncomment below (bucket_name must match the created bucket)
  // "r2_buckets": [
  //   { "binding": "TRICORE_MEDIA", "bucket_name": "tricore-media" }
  // ],
  "observability": {
    "enabled": true
  }
}
